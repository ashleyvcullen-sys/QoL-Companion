<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The magic-link redirect target.

                 Sign-in emails a link back to com.qolcompanion.app://login-callback,
                 which is the same custom scheme iOS registers in Info.plist
                 (CFBundleURLTypes). Without this filter Android has nothing
                 registered for that scheme: tapping the link in the email opens
                 a browser, the browser cannot open it either, and the person is
                 left outside the app with no way in and no error explaining it.

                 BROWSABLE is what lets it be opened from an email or browser
                 rather than only by another app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.qolcompanion.app" android:host="login-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 (API 33) and up will not deliver ANY notification without
         this, and asks the user at runtime as well. Missing, reminders fail
         silently: nothing errors, they simply never arrive, which is the
         worst way for a reminder feature to break.

         @capacitor/local-notifications raises the runtime prompt through the
         permission request the app already makes before scheduling. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets reminder notifications fire at the exact scheduled time rather
         than within the OS's default battery-saving delivery window. Not
         required — @capacitor/local-notifications falls back to inexact
         delivery automatically if this is denied, which is a fine outcome
         for a "check in every few days" reminder. Declaring it means Google
         Play Console will ask for a justification during review; if that
         becomes friction, this can be dropped and the exact-alarm UI in
         Schedule.jsx removed along with it, no functional loss beyond
         precise timing. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
