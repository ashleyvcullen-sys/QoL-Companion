VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public RevenueCat SDK key for the App Store build (appl_ prefix).
VITE_REVENUECAT_API_KEY=
# Optional. 'true' raises the RevenueCat SDK to DEBUG logging. Needed because
# the native app always runs a production Vite bundle, so import.meta.env.DEV
# is false there and cannot be used to detect a debug build.
VITE_REVENUECAT_DEBUG=
